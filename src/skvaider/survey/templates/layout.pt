<!DOCTYPE html>
<html lang="{{ '${request.locale_name}' }}" metal:define-macro="layout">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="pyramid web application">
  <meta name="author" content="Pylons Project">
  <link rel="shortcut icon" href="${request.static_url('skvaider.survey:static/pyramid-16x16.png')}">

  <title>Skvaider survey</title>

  <link href="${request.static_url('skvaider.survey:static/css/bootstrap.min.css')}" rel="stylesheet">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@100..900&family=Geist:wght@100..900&display=swap"
        rel="stylesheet">

  <!-- Custom styles for this scaffold -->
  <link href="${request.static_url('skvaider.survey:static/css/theme.css')}" rel="stylesheet">


  <script type="module" src="${request.static_url('skvaider.survey:static/js/htmx.min.js')}"></script>
  <script type="module" src="${request.static_url('skvaider.survey:static/js/_hyperscript.min.js')}"></script>

</head>

<body data-bs-theme="light">

  <div class="container my-5">
    <div metal:define-slot="content"></div>
  </div>

  <script type="module" src="${request.static_url('skvaider.survey:static/js/bootstrap.bundle.min.js')}"></script>

</body>

</html>
